# Required production secrets
GEMINI_API_KEY=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
ADMIN_API_KEY=""

# Set after the first Cloud Run deployment.
APP_URL=""

# Cloud Run / Google Cloud resources
GOOGLE_CLOUD_PROJECT=""
GCS_AUDIO_BUCKET=""
FIRESTORE_LINE_LOGS_COLLECTION="line_webhook_logs"
FIRESTORE_LINE_EVENTS_COLLECTION="line_webhook_events"

# Runtime
NODE_ENV="production"
PORT="8080"

# OPENAI_API_KEY: Required for OpenAI Text-to-Speech API calls (Optional, fallback is available)
OPENAI_API_KEY=""

# ELEVENLABS_API_KEY: Required for ElevenLabs API calls (Optional, fallback is available)
ELEVENLABS_API_KEY=""
