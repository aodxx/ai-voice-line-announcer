# Required production secrets
GEMINI_API_KEY=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
ADMIN_API_KEY=""

# Set after the first Koyeb deployment.
APP_URL=""

# Supabase server-side resources. Never expose the service-role key in the browser.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AUDIO_BUCKET="line-audio"
SUPABASE_LINE_LOGS_TABLE="line_webhook_logs"
SUPABASE_LINE_EVENTS_TABLE="line_webhook_events"

# Runtime
NODE_ENV="production"
PORT="8080"

# OPENAI_API_KEY: Required for OpenAI Text-to-Speech API calls (Optional, fallback is available)
OPENAI_API_KEY=""

# ELEVENLABS_API_KEY: Required for ElevenLabs API calls (Optional, fallback is available)
ELEVENLABS_API_KEY=""
